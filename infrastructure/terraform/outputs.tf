output "employee_ecr_repo" { value = aws_ecr_repository.employee.repository_url }
output "leave_ecr_repo" { value = aws_ecr_repository.leave.repository_url }
output "ecs_cluster" { value = aws_ecs_cluster.this.name }
output "internal_alb_dns" { value = aws_lb.internal.dns_name }
output "api_base_url" { value = aws_apigatewayv2_stage.this.invoke_url }

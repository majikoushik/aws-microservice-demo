environment         = "prod"
region              = "us-east-2"
vpc_cidr            = "10.40.0.0/16"
db_instance_class   = "db.t4g.medium"
db_allocated_storage = 50
db_multi_az         = true
deletion_protection = true
private_ecs_with_nat = true
# For first infrastructure apply keep false; deploy after images are built.
enable_services     = false
employee_image_tag  = "REPLACE_WITH_IMMUTABLE_BUILD_SHA"
leave_image_tag     = "REPLACE_WITH_IMMUTABLE_BUILD_SHA"
ecs_desired_count   = 2
# Supply TF_VAR_db_password securely.
# github_repo_url = "https://github.com/OWNER/REPO"
# codebuild_connection_arn = "arn:aws:codeconnections:us-east-2:ACCOUNT:connection/UUID"
